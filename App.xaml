<Application x:Class="StealthDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#18181B" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#27272A" />
        <SolidColorBrush x:Key="FrameBrush" Color="#27272A" />
        <SolidColorBrush x:Key="ControlBrush" Color="#3F3F46" />
        <SolidColorBrush x:Key="PressedBrush" Color="#52525B" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="BannerBrush" Color="#1C2333" />

        <!-- Dark tooltip (its popup HWND is capture-shielded by CaptureShield) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource ToolbarBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Application.Resources>
</Application>
