<Window x:Class="StealthDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="StealthDeck"
        Width="980" Height="640" MinWidth="560" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Flat square icon button (Back / Forward / Reload / Hide) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button: same shape as IconButton, red on hover -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text pill button (Clear, banner actions) -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentTextButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented mode pill -->
        <Style x:Key="ModePill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Mode" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded input with placeholder taken from Tag -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid Margin="8,0">
                                <TextBlock x:Name="Placeholder"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim opacity slider -->
        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" VerticalAlignment="Center" Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{StaticResource ControlBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackButton}" Background="{StaticResource AccentBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackButton}" Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource TextBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource FrameBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Top control bar (draggable via WindowChrome caption) ============ -->
            <Border Grid.Row="0" Background="{StaticResource ToolbarBrush}">
                <Grid Margin="6,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- mode switcher -->
                        <ColumnDefinition Width="*" />     <!-- contextual controls -->
                        <ColumnDefinition Width="28" />    <!-- guaranteed drag area -->
                        <ColumnDefinition Width="Auto" />  <!-- badges -->
                        <ColumnDefinition Width="Auto" />  <!-- opacity -->
                        <ColumnDefinition Width="Auto" />  <!-- hide -->
                        <ColumnDefinition Width="Auto" />  <!-- close -->
                    </Grid.ColumnDefinitions>

                    <!-- Mode switcher -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="BrowserModeButton" Content="Browser" Style="{StaticResource ModePill}" IsChecked="True" />
                            <RadioButton x:Name="NotesModeButton" Content="Notes" Style="{StaticResource ModePill}" />
                        </StackPanel>
                    </Border>

                    <!-- Browser controls -->
                    <Grid x:Name="BrowserControls" Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Grid.Column="0" Content="&#x2190;" Style="{StaticResource IconButton}" ToolTip="Back" Click="BackButton_Click" IsEnabled="False" />
                        <Button x:Name="ForwardButton" Grid.Column="1" Content="&#x2192;" Style="{StaticResource IconButton}" ToolTip="Forward" Click="ForwardButton_Click" IsEnabled="False" />
                        <Button x:Name="ReloadButton" Grid.Column="2" Content="&#x21BB;" Style="{StaticResource IconButton}" ToolTip="Reload" Click="ReloadButton_Click" />
                        <TextBox x:Name="UrlBox" Grid.Column="3" Margin="6,0,0,0"
                                 Style="{StaticResource InputBox}"
                                 Tag="Search Google or enter a URL"
                                 KeyDown="UrlBox_KeyDown"
                                 GotKeyboardFocus="UrlBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="UrlBox_PreviewMouseLeftButtonDown" />
                    </Grid>

                    <!-- Notes controls -->
                    <StackPanel x:Name="NotesControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="NotesStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="4,0,6,0" />
                        <TextBlock x:Name="NotesStatusText" Text="Saved" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <Button Content="Clear" Style="{StaticResource TextButton}" Margin="12,0,0,0" ToolTip="Clear all notes (Ctrl+Z to undo)" Click="ClearNotes_Click" />
                    </StackPanel>

                    <!-- Badges -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShieldWarningButton" Style="{StaticResource TextButton}" Background="Transparent"
                                Foreground="{StaticResource WarningBrush}" Visibility="Collapsed" Margin="0,0,6,0"
                                Click="ShieldWarningButton_Click">
                            <TextBlock x:Name="ShieldWarningText" Text="&#x26A0; Visible to capture" FontSize="11" />
                        </Button>
                        <Border x:Name="ClickThroughBadge" Background="{StaticResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="CLICK-THROUGH" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Opacity -->
                    <!-- Opacity: drag the slider, click the track, or scroll the mouse wheel anywhere on this pill -->
                    <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="10,0,8,0" Height="24"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Window opacity (scroll to adjust, Ctrl+Alt+Shift+= / -)"
                            PreviewMouseWheel="OpacityControl_PreviewMouseWheel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x25D0;" FontFamily="Segoe UI Symbol" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Opacity" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="OpacitySlider" Width="100" Minimum="25" Maximum="100" SmallChange="1" LargeChange="10" Style="{StaticResource SlimSlider}" />
                            <TextBlock x:Name="OpacityLabel" Text="95%" Width="36" TextAlignment="Right" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Hide to tray -->
                    <Button Grid.Column="5" Content="&#x2014;" Style="{StaticResource IconButton}" ToolTip="Hide to tray (Ctrl+Shift+H)" Click="HideButton_Click" />

                    <!-- Close: exits StealthDeck completely -->
                    <Button Grid.Column="6" Content="&#x2715;" Style="{StaticResource CloseButton}" ToolTip="Close StealthDeck (exit)" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <!-- ============ Content area ============ -->
            <!-- 6px side/bottom gutter keeps WindowChrome resize edges outside the WebView2 child HWND. -->
            <Grid Grid.Row="1" Margin="6,6,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- In-overlay banner: replaces native JS dialogs, download flyouts and status popups,
                     all of which would otherwise be separate capturable windows. -->
                <Border x:Name="Banner" Grid.Row="0" Background="{StaticResource BannerBrush}" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                            </ScrollViewer>
                            <TextBox x:Name="BannerInput" Style="{StaticResource InputBox}" Margin="0,6,0,0" Visibility="Collapsed" KeyDown="BannerInput_KeyDown" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                            <Button x:Name="BannerCancelButton" Content="Cancel" Style="{StaticResource TextButton}" Click="BannerCancel_Click" />
                            <Button x:Name="BannerOkButton" Content="OK" Style="{StaticResource AccentTextButton}" Click="BannerOk_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Browser view -->
                <Grid x:Name="BrowserHost" Grid.Row="1">
                    <TextBlock x:Name="BrowserFallback" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="Collapsed" />
                    <wv2:WebView2 x:Name="WebView" />
                </Grid>

                <!-- Notes view -->
                <Border x:Name="NotesHost" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource FrameBrush}"
                        BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <TextBox x:Name="NotesBox"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas, Segoe UI"
                             FontSize="14"
                             Padding="14,12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             SelectionBrush="{StaticResource AccentBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
